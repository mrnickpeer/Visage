{
  "manifest_version": 3,
  "name": "Visage - Digital Footprint & Identity Privacy Workstation",
  "version": "1.2.1",
  "description": "Digital Footprint & Identity Privacy Audit Workstation. Audit public exposure, check leaked credentials, and evaluate privacy risks.",
  "permissions": [
    "storage",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "https://keyserver.ubuntu.com/*",
    "https://pgp.surf.nl/*",
    "https://keybase.io/*",
    "https://api.github.com/*",
    "https://api.pwnedpasswords.com/*",
    "https://nominatim.openstreetmap.org/*",
    "https://gitlab.com/*",
    "https://hub.docker.com/*",
    "https://*.gravatar.com/*",
    "https://rubygems.org/*",
    "https://wakatime.com/*",
    "https://codeberg.org/*",
    "https://huggingface.co/*",
    "https://mastodon.social/*",
    "https://lemmy.world/*",
    "https://meta.discourse.org/*"
  ],
  "optional_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Visage Workstation",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "visage@local.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
