{
  "manifest_version": 3,
  "name": "Visage - Digital Footprint & Identity Privacy Workstation",
  "version": "1.1.0",
  "description": "Digital Footprint & Identity Privacy Audit Workstation. Audit public exposure, check leaked credentials, and evaluate privacy risks.",
  "permissions": [
    "storage",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "https://keyserver.ubuntu.com/*",
    "https://pgp.surf.nl/*",
    "https://keybase.io/*",
    "https://api.github.com/*",
    "https://api.pwnedpasswords.com/*",
    "https://nominatim.openstreetmap.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Visage Workstation",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "minimum_chrome_version": "109"
}
